# NexaAI - Environment Configuration Template
# Duplicate this file to .env and provide your secret credentials.
# NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexa_ai

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Server-Side Only - Never expose to Frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

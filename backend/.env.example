# NexaAI Backend Configuration Template
# Copy this file to backend/.env and populate with your credentials.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite async local default, or PostgreSQL async in Docker/Production)
DATABASE_URL=sqlite+aiosqlite:///./nexa_ai.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nexa_ai

# LangGraph Multi-Node Workflow Agent
ENABLE_LANGGRAPH=true

# Cache & Distributed Storage (Optional)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Strictly server-side; NEVER exposed to clients)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
